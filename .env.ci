# Non-secret values for CI (#3). Every integration uses its mock or console provider, so CI needs
# no credentials. Do not add secrets here; real credentials come from #109 and the other
# chore(human) issues listed in docs/engineering/env.md.
NODE_ENV=test
CI=true
LOG_LEVEL=warn
AWS_REGION=ap-south-1
DATA_REGION=in
AI_INDIA_ONLY=true
EMAIL_PROVIDER=console
SMS_PROVIDER=console
AI_PROVIDER=mock
STORAGE_PROVIDER=minio
BILLING_PROVIDER=mock
AUTH_GOOGLE_ENABLED=false
SENTRY_ENABLED=false
