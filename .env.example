# CauseDeck environment variables.
# Generated by `pnpm env:example` from packages/config/src/env. Do not edit by hand.
# Every integration defaults to a mock or console provider, so dev and CI need no secrets.
# Reference: docs/engineering/env.md

# ---- shared ----

# Runtime mode. Dev defaults apply only when this is not `production`.
# type: enum(development|test|production); required when: never (defaults to development); owner: #4
NODE_ENV=development

# Set by CI runners.
# type: boolean; required when: never; owner: #3
CI=false

# pino log level.
# type: enum(fatal|error|warn|info|debug|trace|silent); required when: never (defaults to info); owner: #13
LOG_LEVEL=info

# AWS region for infrastructure. Must be in India unless AWS_REGION_OVERRIDE_ACK is set.
# type: string; required when: never (defaults to ap-south-1); owner: #4
AWS_REGION=ap-south-1

# Data residency region. Must be `in` unless AWS_REGION_OVERRIDE_ACK is set.
# type: string; required when: never (defaults to in); owner: #4
DATA_REGION=in

# Set to I_UNDERSTAND to allow a non-India AWS_REGION or DATA_REGION.
# type: literal(I_UNDERSTAND); required when: AWS_REGION or DATA_REGION outside India; owner: #4
AWS_REGION_OVERRIDE_ACK=

# Restrict AI processing to India-hosted providers.
# type: boolean; required when: never (defaults to true); owner: #44
AI_INDIA_ONLY=true

# Set to I_UNDERSTAND to allow AI_INDIA_ONLY=false in production.
# type: literal(I_UNDERSTAND); required when: NODE_ENV=production and AI_INDIA_ONLY=false; owner: #44
AI_INDIA_ONLY_OVERRIDE_ACK=

# Allow mock/console providers in production (staging demos only).
# type: boolean; required when: never; owner: #4
ALLOW_MOCK_PROVIDERS=false

# Set to 1 to skip validation during Docker image builds. Never set it at runtime.
# type: literal(1); required when: never; owner: #4
SKIP_ENV_VALIDATION=

# ---- server ----

# Postgres connection URL for the app role. Local default points at #5 Postgres.
# type: secret url; required when: NODE_ENV=production; owner: #6; credential: #116; local default: dev placeholder
DATABASE_URL=

# Postgres connection URL for the schema owner role (migrations).
# type: secret url; required when: running migrations; owner: #6; credential: #116; local default: dev placeholder
DATABASE_URL_OWNER=

# Public URL of the web app.
# type: url; required when: NODE_ENV=production; owner: #10; local default: http://localhost:3000
APP_URL=

# Public URL of the API service.
# type: url; required when: NODE_ENV=production; owner: #14; local default: http://localhost:3001
API_URL=

# Better Auth signing secret, at least 32 characters.
# type: secret (>= 32 chars); required when: NODE_ENV=production; owner: #12; credential: #116; local default: dev placeholder
BETTER_AUTH_SECRET=

# HMAC key that signs the public status snapshot (status/status.json), at least 32 characters.
# type: secret (>= 32 chars); required when: NODE_ENV=production; owner: #769; local default: dev placeholder
STATUS_SIGNING_KEY=

# Key-encryption key for envelope encryption, base64 of exactly 32 bytes.
# type: secret base64 (32 bytes); required when: NODE_ENV=production; owner: #21; credential: #116; local default: dev placeholder
KEK_BASE64=

# Web push VAPID public key.
# type: string; required when: VAPID_PRIVATE_KEY is set; owner: #23; credential: #116
VAPID_PUBLIC_KEY=

# Web push VAPID private key.
# type: secret; required when: VAPID_PUBLIC_KEY is set; owner: #23; credential: #116
VAPID_PRIVATE_KEY=

# Web push VAPID subject (contact for push services). Defaults to mailto:push@<APP_URL host>.
# type: mailto: or https url; required when: never; owner: #197
VAPID_SUBJECT=

# WhatsApp Business Platform phone number id that outbound messages are sent from.
# type: string; required when: WHATSAPP_ACCESS_TOKEN is set; owner: #679; credential: #488
WHATSAPP_PHONE_NUMBER_ID=

# WhatsApp Business Platform access token. Without it WhatsApp delivery is disabled.
# type: secret; required when: WHATSAPP_PHONE_NUMBER_ID is set; owner: #679; credential: #488
WHATSAPP_ACCESS_TOKEN=

# WhatsApp Business Platform Graph API version. Defaults to v21.0.
# type: string (vNN.N); required when: never; owner: #679
WHATSAPP_API_VERSION=

# OpenTelemetry OTLP exporter endpoint. Tracing export is off when unset.
# type: url; required when: never; owner: #13
OTEL_EXPORTER_OTLP_ENDPOINT=

# Port the API service listens on.
# type: port; required when: never; owner: #14
API_PORT=3001

# Port the worker serves /healthz and /readyz on.
# type: port; required when: never; owner: #15
WORKER_PORT=3003

# Build commit SHA; used as the service version and Sentry release.
# type: string; required when: never; owner: #13
GIT_SHA=

# Public URL of the staff admin console (apps/admin).
# type: url; required when: NODE_ENV=production, for apps/admin only; owner: #309; local default: http://localhost:3200
ADMIN_URL=

# Optional client IP allowlist for apps/admin (IPv4/IPv6 addresses or CIDRs, comma-separated). Unset allows any IP.
# type: list (comma-separated IPs/CIDRs); required when: never (set per deployment); owner: #309
ADMIN_IP_ALLOWLIST=

# Cloudflare Access application audience tag. When set, apps/admin requires a valid Cf-Access-Jwt-Assertion.
# type: string; required when: never (set per deployment); owner: #309
CF_ACCESS_AUD=

# Cloudflare Access team domain that signs the JWT, e.g. team.cloudflareaccess.com.
# type: host; required when: CF_ACCESS_AUD is set; owner: #309
CF_ACCESS_TEAM_DOMAIN=

# Environment tag shown in the admin console strip. Defaults to production when NODE_ENV=production, else development.
# type: enum(development|staging|production); required when: never; owner: #309
ADMIN_ENV_LABEL=

# Legal name of the supplier on SaaS GST invoices. Outside production a TEST supplier is used when unset.
# type: string; required when: never (issuing an invoice in production refuses while unset); owner: #253
BILLING_SUPPLIER_LEGAL_NAME=

# Registered address of the supplier on SaaS GST invoices.
# type: string; required when: never; owner: #253
BILLING_SUPPLIER_ADDRESS=

# GSTIN of the supplier on SaaS GST invoices; its state code decides CGST+SGST or IGST.
# type: GSTIN; required when: never (issuing an invoice in production refuses while unset); owner: #253
BILLING_SUPPLIER_GSTIN=

# SaaS invoice number series, as in CD/26-27/000001.
# type: string (1-3 capitals); required when: never (defaults to CD); owner: #253
BILLING_INVOICE_SERIES=CD

# SAC printed on SaaS GST invoices (needs CA confirmation).
# type: string (99xxxx); required when: never (defaults to 998314); owner: #253
BILLING_SAC=998314

# Directory of lawyer-supplied adapter fixtures (<adapter-id>/manifest.json layout) for the golden runner. Never committed; unset in CI.
# type: path; required when: never; owner: #371
ADAPTER_PRIVATE_FIXTURES_DIR=

# AlterLab API key for the governed fetch layer. Unset means the offline mock provider serves fixtures.
# type: secret; required when: never (the mock provider is used when unset); owner: #479
ALTERLAB_API_KEY=

# Slack incoming-webhook URL for data-ops alerts. Unset means alerts go to the email mailbox or the log.
# type: secret; required when: never (alerts are logged when unset); owner: #515
DATA_OPS_SLACK_WEBHOOK_URL=

# Mailbox that receives data-ops alerts, besides the on-call staff member. Unset means no mailbox.
# type: email; required when: never (alerts are logged when unset); owner: #515
DATA_OPS_ALERT_EMAIL=

# Per-advocate hourly allowance for delegated captcha-tier lookups in the governed fetch layer.
# type: integer (1-1000); required when: never (defaults to 10); owner: #479
FETCH_DELEGATED_CAPTCHA_PER_HOUR=10

# Founders who receive the weekly business digest and cost-per-user alerts. Unset sends nothing.
# type: list (comma-separated emails); required when: never (set per deployment); owner: #519
BUSINESS_FOUNDER_EMAILS=

# Monthly infrastructure cost in paise, spread over active users in the business dashboard (infra is not metered).
# type: integer (paise); required when: never (defaults to 0); owner: #519
BUSINESS_INFRA_COST_PAISE_MONTHLY=0

# Monthly cost to serve per active user, in paise, above which a plan raises a business alert.
# type: integer (paise); required when: never (defaults to 4000); owner: #519
BUSINESS_COST_PER_USER_ALERT_PAISE=4000

# Exchange rate used to turn fetch_log dollar costs into paise.
# type: number (INR per USD); required when: never (defaults to 85); owner: #519
BUSINESS_USD_INR=85

# ---- email ----

# Email transport. `console` logs messages; `ses` and `smtp` send them.
# type: enum(console|ses|smtp); required when: never (defaults to console); owner: #23
EMAIL_PROVIDER=console

# Amazon SES region (ap-south-1 for India).
# type: string; required when: EMAIL_PROVIDER=ses; owner: #23; credential: #110
SES_REGION=

# Amazon SES IAM access key id.
# type: string; required when: EMAIL_PROVIDER=ses; owner: #23; credential: #110
SES_ACCESS_KEY_ID=

# Amazon SES IAM secret access key.
# type: secret; required when: EMAIL_PROVIDER=ses; owner: #23; credential: #110
SES_SECRET_ACCESS_KEY=

# SMTP connection URL. Local default points at Mailpit (#5).
# type: secret url; required when: EMAIL_PROVIDER=smtp; owner: #23; credential: #110; local default: dev placeholder
SMTP_URL=

# ---- sms ----

# SMS transport for phone sign-in OTPs. `console` logs messages outside production; `msg91` sends through a DLT-registered template.
# type: enum(console|msg91); required when: never (defaults to console); owner: #503
SMS_PROVIDER=console

# MSG91 auth key.
# type: secret; required when: SMS_PROVIDER=msg91; owner: #503
SMS_AUTH_KEY=

# DLT-registered six-character sender id (header).
# type: string; required when: SMS_PROVIDER=msg91; owner: #503
SMS_SENDER_ID=

# DLT principal entity id registered with the operator.
# type: string; required when: SMS_PROVIDER=msg91; owner: #503
SMS_DLT_ENTITY_ID=

# MSG91 template id of the DLT-registered OTP template.
# type: string; required when: SMS_PROVIDER=msg91; owner: #503
SMS_OTP_TEMPLATE_ID=

# ---- ai ----

# AI gateway provider. `mock` returns canned responses.
# type: enum(mock|bedrock|sarvam); required when: never (defaults to mock); owner: #44
AI_PROVIDER=mock

# AWS Bedrock region. Must be an India region while AI_INDIA_ONLY=true.
# type: string; required when: AI_PROVIDER=bedrock; owner: #44; credential: #112
BEDROCK_REGION=ap-south-1

# AWS Bedrock IAM access key id.
# type: string; required when: AI_PROVIDER=bedrock; owner: #44; credential: #112
BEDROCK_ACCESS_KEY_ID=

# AWS Bedrock IAM secret access key.
# type: secret; required when: AI_PROVIDER=bedrock; owner: #44; credential: #112
BEDROCK_SECRET_ACCESS_KEY=

# AWS Bedrock model id.
# type: string; required when: AI_PROVIDER=bedrock; owner: #44; credential: #112
BEDROCK_MODEL_ID=

# AWS Bedrock Sonnet-class model id for drafting tasks. Defaults to BEDROCK_MODEL_ID.
# type: string; required when: never (optional with AI_PROVIDER=bedrock); owner: #44; credential: #112
BEDROCK_DRAFTING_MODEL_ID=

# Maximum concurrent AI gateway calls per workspace.
# type: integer (1-32); required when: never (defaults to 4); owner: #44
AI_MAX_CONCURRENCY_PER_WORKSPACE=4

# Set to true once the Sarvam contract confirms no training on customer data. Production refuses to boot with a real Sarvam key without it.
# type: literal(true); required when: NODE_ENV=production and AI_PROVIDER=sarvam; owner: #44; credential: #113
SARVAM_NO_TRAINING_CONFIRMED=

# Sarvam API key (Indic STT and OCR).
# type: secret; required when: AI_PROVIDER=sarvam; owner: #44; credential: #113
SARVAM_API_KEY=

# ---- storage ----

# Object storage backend: MinIO on the VPS or AWS S3 ap-south-1.
# type: enum(minio|s3); required when: never (defaults to minio); owner: #21
STORAGE_PROVIDER=minio

# S3-compatible endpoint. Local default points at MinIO (#5).
# type: url; required when: STORAGE_PROVIDER=minio; owner: #21; local default: http://localhost:9000
S3_ENDPOINT=

# Storage region. Must be an India region (ap-south-1, ap-south-2) unless AWS_REGION_OVERRIDE_ACK is set.
# type: string; required when: never (defaults to ap-south-1); owner: #21
S3_REGION=ap-south-1

# Bucket for tenant documents.
# type: string; required when: always (dev default outside production); owner: #21; local default: causedeck-dev
S3_BUCKET=

# S3 access key.
# type: secret; required when: always (dev default outside production); owner: #21; credential: #116; local default: dev placeholder
S3_ACCESS_KEY=

# S3 secret key.
# type: secret; required when: always (dev default outside production); owner: #21; credential: #116; local default: dev placeholder
S3_SECRET_KEY=

# ---- billing ----

# Billing provider. `mock` simulates subscriptions.
# type: enum(mock|razorpay); required when: never (defaults to mock); owner: #28
BILLING_PROVIDER=mock

# Razorpay API key id.
# type: string; required when: BILLING_PROVIDER=razorpay; owner: #28; credential: #111
RAZORPAY_KEY_ID=

# Razorpay API key secret.
# type: secret; required when: BILLING_PROVIDER=razorpay; owner: #28; credential: #111
RAZORPAY_SECRET=

# Razorpay webhook signing secret.
# type: secret; required when: BILLING_PROVIDER=razorpay; owner: #28; credential: #111
RAZORPAY_WEBHOOK_SECRET=

# ---- auth ----

# Enable Google OAuth sign-in.
# type: boolean; required when: never (defaults to false); owner: #12
AUTH_GOOGLE_ENABLED=false

# Google OAuth client id.
# type: string; required when: AUTH_GOOGLE_ENABLED=true; owner: #12; credential: #109
GOOGLE_CLIENT_ID=

# Google OAuth client secret.
# type: secret; required when: AUTH_GOOGLE_ENABLED=true; owner: #12; credential: #109
GOOGLE_CLIENT_SECRET=

# ---- observability ----

# Report errors to Sentry.
# type: boolean; required when: never (defaults to false); owner: #13
SENTRY_ENABLED=false

# Sentry DSN.
# type: url; required when: SENTRY_ENABLED=true; owner: #13; credential: #115
SENTRY_DSN=

# ---- client ----

# Public URL of the web app, exposed to the browser.
# type: url; required when: NODE_ENV=production; owner: #10; local default: http://localhost:3000
NEXT_PUBLIC_APP_URL=

# Support WhatsApp number shown in the help Contact tab; unset hides the WhatsApp link.
# type: string (E.164); required when: never; owner: #94
NEXT_PUBLIC_SUPPORT_WHATSAPP=

# ---- kill-switches ----

# Env kill-switches, e.g. KILL_AI=true. Every KILL_<NAME> key is parsed as a boolean.
# type: boolean; required when: never; owner: #22
# KILL_<NAME>=false
