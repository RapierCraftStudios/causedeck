# Local development defaults for the Docker stack in infra/docker/compose.dev.yml (`pnpm stack:up`).
# Copy to .env.local (git-ignored). These credentials are local-only and must never be used in
# staging or production. This file will be regenerated from the env schema by `pnpm env:example`
# once #4 lands; keep the key names in sync with that schema.

# Postgres 17 + pgvector. Apps connect as the non-owner app role; migrations use the owner role.
DATABASE_URL=postgres://causedeck_app:causedeck_app@127.0.0.1:5432/causedeck
DATABASE_URL_OWNER=postgres://causedeck_owner:causedeck_owner@127.0.0.1:5432/causedeck

# MinIO (S3-compatible). Console: http://127.0.0.1:9001
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=causedeck-dev
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Mailpit SMTP sink. Inbox UI: http://127.0.0.1:8025
SMTP_URL=smtp://127.0.0.1:1025
