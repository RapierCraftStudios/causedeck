{
  "inbox-visual-baselines": {
    "run": "test -n \"$(find e2e/__screenshots__ -path '*inbox*' -name 'inbox-*.png' 2>/dev/null | head -n 1)\"",
    "pass": "exit 0",
    "timeout": 30
  },
  "copilot-demo-journey": {
    "run": "pnpm --filter @causedeck/e2e test tests/matters/copilot.spec.ts",
    "pass": "exit 0",
    "timeout": 600
  },
  "statutes-section-journey": {
    "run": "pnpm --filter @causedeck/e2e test tests/research/statutes.spec.ts",
    "pass": "exit 0",
    "timeout": 600
  },
  "drafting-citations-journey": {
    "run": "pnpm --filter @causedeck/e2e test tests/drafting/citations.spec.ts",
    "pass": "exit 0",
    "timeout": 600
  },
  "drafting-authority-insert-journey": {
    "run": "pnpm --filter @causedeck/e2e test tests/drafting/authority-insert.spec.ts",
    "pass": "exit 0",
    "timeout": 600
  },
  "e2e-staging-pr-green": {
    "run": "pr=\"$(gh pr list --base staging --head milestone/restore-green-e2e --state all --json number --jq '.[0].number')\" && test -n \"$pr\" && gh pr checks \"$pr\" --json name,bucket --jq '.[] | select(.name == \"e2e\") | .bucket' | grep -qx pass",
    "pass": "exit 0",
    "timeout": 60
  }
}
