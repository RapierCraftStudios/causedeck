{
  "openapi": "3.1.0",
  "info": {
    "title": "CauseDeck API",
    "version": "1.0.0",
    "description": "Public REST API. Errors are RFC 9457 problem+json; see docs/engineering/api.md."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      },
      "bearerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "type": ["string", "null"]
              },
              "image": {
                "type": ["string", "null"]
              },
              "locale": {
                "type": "string",
                "enum": ["en", "ta", "kn"]
              }
            },
            "required": ["id", "email", "name", "image", "locale"]
          },
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "workspaceId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["owner", "advocate", "junior", "clerk", "viewer"]
                }
              },
              "required": ["workspaceId", "name", "slug", "role"]
            }
          }
        },
        "required": ["user", "memberships"]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "RATE_LIMITED",
              "INTERNAL"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["type", "title", "status", "code", "requestId"]
      },
      "WorkspaceList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["owner", "advocate", "junior", "clerk", "viewer"]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": ["id", "name", "slug", "role", "createdAt"]
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "BillingPlans": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["junior", "advocate", "chamber", "dedicated"]
                },
                "interval": {
                  "type": "string",
                  "enum": ["month", "year"]
                },
                "pricePaise": {
                  "type": "integer",
                  "minimum": 0
                },
                "perSeat": {
                  "type": "boolean"
                },
                "clerkSeatPricePaise": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "minSeats": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "id",
                "name",
                "kind",
                "interval",
                "pricePaise",
                "perSeat",
                "clerkSeatPricePaise",
                "minSeats"
              ]
            }
          }
        },
        "required": ["data"]
      },
      "BillingSubscription": {
        "type": "object",
        "properties": {
          "subscription": {
            "type": ["object", "null"],
            "properties": {
              "id": {
                "type": "string"
              },
              "planId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["trialing", "active", "past_due", "paused", "cancelled", "expired"]
              },
              "seats": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "clerkSeats": {
                "type": "integer",
                "minimum": 0
              },
              "currentPeriodStart": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "currentPeriodEnd": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "graceUntil": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "cancelAtPeriodEnd": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "planId",
              "status",
              "seats",
              "clerkSeats",
              "currentPeriodStart",
              "currentPeriodEnd",
              "graceUntil",
              "cancelAtPeriodEnd"
            ]
          }
        },
        "required": ["subscription"]
      },
      "RazorpayWebhookAck": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "enum": [true]
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": ["received"]
      },
      "InboundEmailAck": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["received"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": ["Account"],
        "summary": "The signed-in user and their workspace memberships",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "tags": ["Workspaces"],
        "summary": "The caller's workspaces",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of workspaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/plans": {
      "get": {
        "operationId": "listBillingPlans",
        "tags": ["Billing"],
        "summary": "The active plan catalogue (prices in paise, ex-GST)",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingPlans"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/subscription": {
      "get": {
        "operationId": "getBillingSubscription",
        "tags": ["Billing"],
        "summary": "The workspace's current subscription (x-workspace-id header)",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The current subscription, or null on the free plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingSubscription"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/cases/{cnr}": {
      "get": {
        "operationId": "getPublicCase",
        "tags": ["Public API"],
        "summary": "Latest status of one of the workspace’s own cases",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[A-Z0-9]{16}$"
            },
            "required": true,
            "name": "cnr",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The case status",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cnr": {
                      "type": "string"
                    },
                    "status": {
                      "type": ["string", "null"]
                    },
                    "next_hearing_date": {
                      "type": ["string", "null"]
                    },
                    "last_hearing_date": {
                      "type": ["string", "null"]
                    },
                    "stage": {
                      "type": ["string", "null"]
                    },
                    "bench": {
                      "type": ["string", "null"]
                    },
                    "fetched_at": {
                      "type": "string"
                    },
                    "orders": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "date": {
                            "type": ["string", "null"]
                          },
                          "number": {
                            "type": ["string", "null"]
                          },
                          "summary": {
                            "type": ["string", "null"]
                          },
                          "url": {
                            "type": ["string", "null"]
                          }
                        },
                        "required": ["date", "number", "summary", "url"]
                      }
                    },
                    "provenance": {
                      "type": "object",
                      "properties": {
                        "source_id": {
                          "type": "string"
                        },
                        "kind": {
                          "type": "string",
                          "enum": ["fetched", "contributed"]
                        },
                        "ref": {
                          "type": ["string", "null"]
                        },
                        "captured_at": {
                          "type": "string"
                        },
                        "confidence": {
                          "type": ["number", "null"]
                        }
                      },
                      "required": ["source_id", "kind", "ref", "captured_at", "confidence"]
                    },
                    "source_license": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "cnr",
                    "status",
                    "next_hearing_date",
                    "last_hearing_date",
                    "stage",
                    "bench",
                    "fetched_at",
                    "orders",
                    "provenance",
                    "source_license"
                  ]
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/causelists": {
      "get": {
        "operationId": "listPublicCauseLists",
        "tags": ["Public API"],
        "summary": "Shared cause lists from cleared, non-personal sources",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": false,
            "name": "forum",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date"
            },
            "required": false,
            "name": "date",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "required": false,
            "name": "advocate",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Cause lists",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "forum": {
                            "type": ["string", "null"]
                          },
                          "listing_date": {
                            "type": ["string", "null"]
                          },
                          "content": {
                            "type": "string"
                          },
                          "provenance": {
                            "type": "object",
                            "properties": {
                              "source_id": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string",
                                "enum": ["fetched", "contributed"]
                              },
                              "ref": {
                                "type": ["string", "null"]
                              },
                              "captured_at": {
                                "type": "string"
                              },
                              "confidence": {
                                "type": ["number", "null"]
                              }
                            },
                            "required": ["source_id", "kind", "ref", "captured_at", "confidence"]
                          },
                          "source_license": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "forum",
                          "listing_date",
                          "content",
                          "provenance",
                          "source_license"
                        ]
                      }
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/orders": {
      "get": {
        "operationId": "listPublicOrders",
        "tags": ["Public API"],
        "summary": "Orders of an own case, or shared published orders from cleared non-personal sources",
        "security": [
          {
            "sessionCookie": []
          },
