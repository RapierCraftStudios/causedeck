{
  "openapi": "3.1.0",
  "info": {
    "title": "CauseDeck API",
    "version": "1.0.0",
    "description": "Public REST API. Errors are RFC 9457 problem+json; see docs/engineering/api.md."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "securitySchemes": {
      "sessionCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "better-auth.session_token"
      },
      "bearerToken": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "name": {
                "type": ["string", "null"]
              },
              "image": {
                "type": ["string", "null"]
              },
              "locale": {
                "type": "string",
                "enum": ["en", "ta", "kn"]
              }
            },
            "required": ["id", "email", "name", "image", "locale"]
          },
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "workspaceId": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["owner", "advocate", "junior", "clerk", "viewer"]
                }
              },
              "required": ["workspaceId", "name", "slug", "role"]
            }
          }
        },
        "required": ["user", "memberships"]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION",
              "UNAUTHENTICATED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "PAYLOAD_TOO_LARGE",
              "RATE_LIMITED",
              "INTERNAL"
            ]
          },
          "requestId": {
            "type": "string"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              },
              "required": ["path", "message"]
            }
          }
        },
        "required": ["type", "title", "status", "code", "requestId"]
      },
      "WorkspaceList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "slug": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["owner", "advocate", "junior", "clerk", "viewer"]
                },
                "createdAt": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "required": ["id", "name", "slug", "role", "createdAt"]
            }
          },
          "nextCursor": {
            "type": ["string", "null"]
          }
        },
        "required": ["data", "nextCursor"]
      },
      "BillingPlans": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "kind": {
                  "type": "string",
                  "enum": ["junior", "advocate", "chamber", "dedicated"]
                },
                "interval": {
                  "type": "string",
                  "enum": ["month", "year"]
                },
                "pricePaise": {
                  "type": "integer",
                  "minimum": 0
                },
                "perSeat": {
                  "type": "boolean"
                },
                "clerkSeatPricePaise": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "minSeats": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "id",
                "name",
                "kind",
                "interval",
                "pricePaise",
                "perSeat",
                "clerkSeatPricePaise",
                "minSeats"
              ]
            }
          }
        },
        "required": ["data"]
      },
      "BillingSubscription": {
        "type": "object",
        "properties": {
          "subscription": {
            "type": ["object", "null"],
            "properties": {
              "id": {
                "type": "string"
              },
              "planId": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": ["trialing", "active", "past_due", "paused", "cancelled", "expired"]
              },
              "seats": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "clerkSeats": {
                "type": "integer",
                "minimum": 0
              },
              "currentPeriodStart": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "currentPeriodEnd": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "graceUntil": {
                "type": ["string", "null"],
                "format": "date-time"
              },
              "cancelAtPeriodEnd": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "planId",
              "status",
              "seats",
              "clerkSeats",
              "currentPeriodStart",
              "currentPeriodEnd",
              "graceUntil",
              "cancelAtPeriodEnd"
            ]
          }
        },
        "required": ["subscription"]
      },
      "RazorpayWebhookAck": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "enum": [true]
          },
          "duplicate": {
            "type": "boolean"
          }
        },
        "required": ["received"]
      },
      "InboundEmailAck": {
        "type": "object",
        "properties": {
          "received": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["received"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/me": {
      "get": {
        "operationId": "getMe",
        "tags": ["Account"],
        "summary": "The signed-in user and their workspace memberships",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The caller",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/workspaces": {
      "get": {
        "operationId": "listWorkspaces",
        "tags": ["Workspaces"],
        "summary": "The caller's workspaces",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "One page of workspaces",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkspaceList"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/plans": {
      "get": {
        "operationId": "listBillingPlans",
        "tags": ["Billing"],
        "summary": "The active plan catalogue (prices in paise, ex-GST)",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Active plans",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingPlans"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/billing/subscription": {
      "get": {
        "operationId": "getBillingSubscription",
        "tags": ["Billing"],
        "summary": "The workspace's current subscription (x-workspace-id header)",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The current subscription, or null on the free plan",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingSubscription"
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhooks/razorpay": {
      "post": {
        "operationId": "receiveRazorpayWebhook",
        "tags": ["Webhooks"],
        "summary": "Razorpay subscription and payment events (signed with X-Razorpay-Signature)",
        "security": [],
        "x-public": true,
        "responses": {
          "200": {
            "description": "Accepted (also for replays and unknown subscriptions)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RazorpayWebhookAck"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/inbound/email": {
      "post": {
        "operationId": "receiveInboundEmail",
        "tags": ["Inbound"],
        "summary": "Inbound email notifications (SNS-signed for SES, shared secret in dev)",
        "security": [],
        "x-public": true,
        "responses": {
          "200": {
            "description": "Accepted (also for duplicates, unknown addresses and disabled channels)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InboundEmailAck"
                }
              }
            }
          },
          "400": {
            "description": "Error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "413": {
            "description": "Payload too large",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
