            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "case": {
                            "type": ["string", "null"]
                          },
                          "date": {
                            "type": ["string", "null"]
                          },
                          "number": {
                            "type": ["string", "null"]
                          },
                          "summary": {
                            "type": ["string", "null"]
                          },
                          "url": {
                            "type": ["string", "null"]
                          },
                          "content": {
                            "type": ["string", "null"]
                          },
                          "forum": {
                            "type": ["string", "null"]
                          },
                          "provenance": {
                            "type": "object",
                            "properties": {
                              "source_id": {
                                "type": "string"
                              },
                              "kind": {
                                "type": "string",
                                "enum": ["fetched", "contributed"]
                              },
                              "ref": {
                                "type": ["string", "null"]
                              },
                              "captured_at": {
                                "type": "string"
                              },
                              "confidence": {
                                "type": ["number", "null"]
                              }
                            },
                            "required": ["source_id", "kind", "ref", "captured_at", "confidence"]
                          },
                          "source_license": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "case",
                          "date",
                          "number",
                          "summary",
                          "url",
                          "content",
                          "forum",
                          "provenance",
                          "source_license"
                        ]
                      }
                    }
                  },
                  "required": ["data"]
                }
              }
            }
          },
          "401": {
            "description": "Not authenticated",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "403": {
            "description": "Not allowed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "429": {
            "description": "Rate limited",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notices": {
      "get": {
        "operationId": "listPublicNotices",
        "tags": ["Public API"],
        "summary": "Official notices from cleared, non-personal sources",
        "security": [
          {
            "sessionCookie": []
          },
          {
            "bearerToken": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "required": false,
            "name": "forum",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            },
            "required": false,
            "name": "limit",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Notices",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
