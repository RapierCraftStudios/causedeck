{
  "name": "@causedeck/api",
  "version": "0.0.0",
  "private": true,
  "description": "Hono REST API (/v1), webhooks, OpenAPI docs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup",
    "start": "tsx src/server.ts",
    "openapi:export": "tsx scripts/export-openapi.ts",
    "openapi:check": "tsx scripts/export-openapi.ts --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:tenancy": "vitest run src/__tests__/cross-tenant.test.ts"
  },
  "dependencies": {
    "@causedeck/auth": "workspace:*",
    "@causedeck/billing": "workspace:*",
    "@causedeck/config": "workspace:*",
    "@causedeck/core": "workspace:*",
    "@causedeck/db": "workspace:*",
    "@causedeck/flags": "workspace:*",
    "@causedeck/observability": "workspace:*",
    "@causedeck/storage": "workspace:*",
    "@causedeck/validators": "workspace:*",
    "@hono/node-server": "catalog:",
    "@hono/zod-openapi": "catalog:",
    "@scalar/hono-api-reference": "catalog:",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "tsx": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "catalog:",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
