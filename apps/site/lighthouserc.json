{
  "ci": {
    "collect": {
      "staticDistDir": "./out",
      "url": [
        "/index.html",
        "/pricing/index.html",
        "/security/index.html",
        "/about/index.html",
        "/changelog/index.html",
        "/legal/index.html",
        "/legal/terms/index.html",
        "/legal/privacy/index.html",
        "/legal/dpa/index.html",
        "/legal/ai-disclosure/index.html",
        "/legal/sub-processors/index.html"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": {
          "mobile": true,
          "width": 412,
          "height": 823,
          "deviceScaleFactor": 1.75,
          "disabled": false
        },
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertMatrix": [
        {
          "matchingUrlPattern": ".*",
          "assertions": {
            "categories:performance": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:accessibility": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "categories:best-practices": [
              "error",
              {
                "minScore": 0.95
              }
            ],
            "resource-summary:script:size": [
              "error",
              {
                "maxNumericValue": 163840
              }
            ],
            "largest-contentful-paint": [
              "error",
              {
                "maxNumericValue": 2800
              }
            ],
            "resource-summary:font:size": [
              "error",
              {
                "maxNumericValue": 153600
              }
            ],
            "resource-summary:third-party:count": [
              "error",
              {
                "maxNumericValue": 0
              }
            ],
            "total-byte-weight": [
              "error",
              {
                "maxNumericValue": 512000
              }
            ]
          }
        },
        {
          "matchingUrlPattern": "^(?!.*/legal/).*$",
          "assertions": {
            "categories:seo": [
              "error",
              {
                "minScore": 0.95
              }
            ]
          }
        }
      ]
    },
    "upload": {
      "target": "filesystem",
      "outputDir": ".lighthouseci"
    }
  }
}
