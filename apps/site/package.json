{
  "name": "@causedeck/site",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js static marketing site (Cloudflare Pages).",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3200",
    "build": "tsx scripts/rule36-lint.ts && next build && tsx scripts/write-headers.ts",
    "lint": "eslint .",
    "lint:rule36": "tsx scripts/rule36-lint.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@causedeck/config": "workspace:*",
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "eslint": "catalog:",
    "postcss": "catalog:",
    "tailwindcss": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "dependencies": {
    "@causedeck/ui": "workspace:*",
    "next": "catalog:",
    "next-mdx-remote": "catalog:",
    "next-themes": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zod": "catalog:"
  }
}
