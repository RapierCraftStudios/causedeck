# Cloudflare Pages response headers. scripts/write-headers.ts appends the Content-Security-Policy
# rules (per-page script hashes, no inline-script allowance) to out/_headers after the build.
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), interest-cohort=()
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# Hashed build assets never change: cache for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
