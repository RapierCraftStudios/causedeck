{
  "name": "@causedeck/web",
  "version": "0.0.0",
  "private": true,
  "description": "Next.js product app (PWA, RSC, server actions).",
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
