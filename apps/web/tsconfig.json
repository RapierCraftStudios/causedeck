{
  "extends": "@causedeck/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "plugins": [{ "name": "next" }]
  },
  "include": [
    "next-env.d.ts",
    ".next/types/**/*.ts",
    "src",
    "app",
    "components",
    "lib",
    "i18n",
    "messages",
    "__tests__",
    "scripts",
    "*.ts",
    "*.tsx"
  ],
  "exclude": ["node_modules", ".next"]
}
