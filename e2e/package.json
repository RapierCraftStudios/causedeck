{
  "name": "@causedeck/e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end, accessibility and visual suites for apps/web, plus Lighthouse CI.",
  "type": "module",
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node support/playwright.mjs",
    "test:ui": "node support/playwright.mjs --ui",
    "test:visual": "node support/playwright.mjs --grep @visual",
    "test:update-snapshots": "node support/playwright.mjs --grep @visual --update-snapshots",
    "lhci": "lhci autorun --config=lighthouserc.json",
    "lhci:courts": "node support/lighthouse-courts.mjs",
    "lhci:calendar": "node support/lighthouse-courts.mjs lighthouserc.calendar.json",
    "lhci:court-day": "node support/lighthouse-courts.mjs lighthouserc.court-day.json /w/chennai-solo/today",
    "lhci:matters": "node --experimental-strip-types --no-warnings support/lighthouse-matters.mjs",
    "perf:test": "vitest run",
    "perf:seed": "node --experimental-strip-types --no-warnings perf/seed-scale.ts",
    "perf:lighthouse": "node --experimental-strip-types --no-warnings perf/lighthouse/run.mjs",
    "perf:bundle": "node --experimental-strip-types --no-warnings ../scripts/check-bundle-budget.ts",
    "lhci:drafting": "node --experimental-strip-types --no-warnings support/lighthouse-matters.mjs lighthouserc.drafting.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@causedeck/config": "workspace:*",
    "@causedeck/db": "workspace:*",
    "@lhci/cli": "catalog:",
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "better-auth": "catalog:",
    "eslint": "catalog:",
    "lighthouse": "catalog:",
    "postgres": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
