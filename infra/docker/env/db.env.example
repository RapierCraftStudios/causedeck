# Environment for infra/docker/compose.db.yml (#887): the Stage B database nodes. Variables only,
# no secrets in git: copy to /etc/causedeck/db.env on each database VPS (0600, owner = deploy
# user). Pass it as `docker compose -f compose.db.yml --env-file /etc/causedeck/db.env ...`.

IMAGE_ORG=
GIT_SHA=

# Address the published ports bind to: the node's own public IPv4 (OVH VPS have no private
# network). The host firewall limits 5432 and 6432 to the app and replica node IPs.
DB_BIND_ADDR=

# Passwords. The app role password must match APP_DB_PASSWORD on the app nodes.
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
REPLICATION_PASSWORD=

# Replica node only: the primary's address (the primary node's public IPv4 or its DNS name).
PRIMARY_HOST=

# WAL-G archive target on the primary: the Hyderabad bucket from #884 (ap-south-2). The archiver
# credentials are write-only. The libsodium key is a file on tmpfs (restore.md, key custody).
WALG_S3_PREFIX=
WALG_AWS_ENDPOINT=
WALG_AWS_REGION=ap-south-2
WALG_KEY_FILE=/run/causedeck/walg.key
WALG_ARCHIVE_ACCESS_KEY=
WALG_ARCHIVE_SECRET_KEY=

# Sizing (VPS-4: 8 vCPU / 24 GB). Leave the rest of the box for the OS and PgBouncer.
POSTGRES_MEM=16g
POSTGRES_CPUS=6.0
# Host directory holding PgBouncer's server.crt and server.key (client TLS is required).
PGBOUNCER_TLS_DIR=/etc/causedeck/pgbouncer-tls
PGBOUNCER_MAX_CLIENT_CONN=400
PGBOUNCER_POOL_SIZE=40
