# Sizing preset: production on an OVH VPS-3 (6 vCPU / 12 GB / 100 GB), D-037 amendment 2026-10-27.
# Sizing only, no secrets. Append it to the prod env file AFTER prod.env.example is filled in
# (the last assignment wins):  cat infra/docker/env/prod-vps3.env >> /etc/causedeck/prod.env
#
# Budget: the app stack (every non-profile service, replicas included) has memory limits totalling
# 7936m, at most 9 GB, which leaves at least 3 GB of the 12 GB for the `core` monitoring profile
# and the OS. Postgres keeps 2 GB or more. Limits are a ceiling, not actual use.
# Enforced by infra/docker/test/compose-smoke.sh and infra/scripts/compose-prod.test.mjs.
WEB_REPLICAS=2
WORKER_REPLICAS=2
CADDY_MEM=128m
CADDY_CPUS=0.25
WEB_MEM=1g
WEB_CPUS=1.5
API_MEM=768m
API_CPUS=1.0
WORKER_MEM=512m
WORKER_CPUS=1.0
ADMIN_MEM=384m
ADMIN_CPUS=0.5
POSTGRES_MEM=3g
POSTGRES_CPUS=3.0
MINIO_MEM=512m
MINIO_CPUS=0.5
