# Production environment for infra/docker/compose.prod.yml (#97). Variables only, no secrets: copy
# to /etc/causedeck/prod.env on the VPS (0600, owner = deploy user) and fill the values. Pass it as
#   export CAUSEDECK_ENV_FILE=/etc/causedeck/prod.env
#   docker compose -f compose.prod.yml --env-file "$CAUSEDECK_ENV_FILE" ...
# The file is also `source`d by infra/scripts/migrate.sh: keep plain KEY=value lines, no spaces
# around `=`, and quote values containing shell metacharacters. The full key reference is
# docs/engineering/env.md (rendered in the repo-root .env.example).

# --- Stack -------------------------------------------------------------------------------------
COMPOSE_ENV_NAME=prod
IMAGE_ORG=
# Set per deploy by the pipeline (#100): the git SHA of the images to run.
GIT_SHA=

# --- Runtime (validated by @causedeck/config at boot; a missing key stops the service) ---------
NODE_ENV=production
LOG_LEVEL=info
APP_URL=
NEXT_PUBLIC_APP_URL=
API_URL=
ADMIN_URL=
AWS_REGION=ap-south-1

# --- Database (passwords here are interpolated into DATABASE_URL by compose) --------------------
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Object storage (MinIO on the same host in Stage A) -----------------------------------------
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=causedeck-prod
S3_ACCESS_KEY=
S3_SECRET_KEY=
# WAL-G archive target; defaults to a bucket in the stack's MinIO. Use off-host storage in prod.
WALG_S3_PREFIX=s3://causedeck-wal
WALG_AWS_ENDPOINT=http://minio:9000

# --- Secrets (generate; never reuse dev values) --------------------------------------------------
BETTER_AUTH_SECRET=
KEK_BASE64=

# --- Billing identity and AI guardrails -----------------------------------------------------------
BILLING_SUPPLIER_LEGAL_NAME=
BILLING_SUPPLIER_GSTIN=
SARVAM_NO_TRAINING_CONFIRMED=

# --- Providers: mocks until real credentials land (#108, #110-#116) --------------------------------
EMAIL_PROVIDER=console
SMS_PROVIDER=console
AI_PROVIDER=mock
BILLING_PROVIDER=mock

# --- Clock check: /readyz fails when the clock drifts more than 1 s from this reference ------------
CLOCK_DRIFT_REFERENCE_URL=https://www.cloudflare.com

# --- Admin console (staff only; never publicly routed, see #98) -----------------------------------
ADMIN_IP_ALLOWLIST=

# --- Resource limits: defaults fit 4 vCPU / 8 GB (README table); override to resize --------------------
# CADDY_MEM=128m
# CADDY_CPUS=0.25
# WEB_MEM=768m
# WEB_CPUS=1.0
# API_MEM=768m
# API_CPUS=1.0
# WORKER_MEM=512m
# WORKER_CPUS=0.75
# ADMIN_MEM=384m
# ADMIN_CPUS=0.5
# POSTGRES_MEM=2g
# POSTGRES_CPUS=2.0
# MINIO_MEM=512m
# MINIO_CPUS=0.5
