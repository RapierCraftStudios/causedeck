# Sizing preset: staging on its own OVH VPS-1 (2 vCPU / 4 GB / 40 GB), D-037 amendment 2026-10-27.
# Sizing only, no secrets. Append it to the staging env file (the last assignment wins):
#   cat infra/docker/env/staging-vps1.env >> /etc/causedeck/staging.env
#
# Budget: 1 web and 1 worker; memory limits for the whole stack, Postgres and MinIO included,
# total 2624m, at most 3 GB. Limits are a ceiling, not actual use.
# Enforced by infra/docker/test/compose-smoke.sh and infra/scripts/compose-prod.test.mjs.
WEB_REPLICAS=1
WORKER_REPLICAS=1
CADDY_MEM=64m
CADDY_CPUS=0.15
WEB_MEM=384m
WEB_CPUS=0.5
API_MEM=384m
API_CPUS=0.5
WORKER_MEM=256m
WORKER_CPUS=0.35
ADMIN_MEM=256m
ADMIN_CPUS=0.25
POSTGRES_MEM=1g
POSTGRES_CPUS=1.0
MINIO_MEM=256m
MINIO_CPUS=0.25
