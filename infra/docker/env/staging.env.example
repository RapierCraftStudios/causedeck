# Staging overrides for infra/docker/compose.prod.yml (#97): the SAME compose file with smaller
# limits and preview data only (never copy production data here). Everything not listed in the
# override block keeps the prod.env.example meaning. Variables only, no secrets: copy
# to /etc/causedeck/prod.env on the VPS (0600, owner = deploy user) and fill the values. Pass it as
#   export CAUSEDECK_ENV_FILE=/etc/causedeck/prod.env
#   docker compose -f compose.prod.yml --env-file "$CAUSEDECK_ENV_FILE" ...
# The file is also `source`d by infra/scripts/migrate.sh: keep plain KEY=value lines, no spaces
# around `=`, and quote values containing shell metacharacters. The full key reference is
# docs/engineering/env.md (rendered in the repo-root .env.example).

# --- Stack -------------------------------------------------------------------------------------
COMPOSE_ENV_NAME=staging
IMAGE_ORG=
# Set per deploy by the pipeline (#100): the git SHA of the images to run.
GIT_SHA=

# --- Runtime (validated by @causedeck/config at boot; a missing key stops the service) ---------
NODE_ENV=production
LOG_LEVEL=info
APP_URL=
NEXT_PUBLIC_APP_URL=
API_URL=
ADMIN_URL=
AWS_REGION=ap-south-1

# --- Database (passwords here are interpolated into DATABASE_URL by compose) --------------------
POSTGRES_PASSWORD=
OWNER_DB_PASSWORD=
APP_DB_PASSWORD=

# --- Object storage (MinIO on the same host in Stage A) -----------------------------------------
STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_REGION=ap-south-1
S3_BUCKET=causedeck-staging
S3_ACCESS_KEY=
S3_SECRET_KEY=
# WAL-G archive target; defaults to a bucket in the stack's MinIO. Use off-host storage in prod.
WALG_S3_PREFIX=s3://causedeck-wal
WALG_AWS_ENDPOINT=http://minio:9000

# --- Secrets (generate; never reuse dev values) --------------------------------------------------
BETTER_AUTH_SECRET=
KEK_BASE64=

# --- Billing identity and AI guardrails -----------------------------------------------------------
BILLING_SUPPLIER_LEGAL_NAME=
BILLING_SUPPLIER_GSTIN=
SARVAM_NO_TRAINING_CONFIRMED=

# --- Providers: mocks until real credentials land (#108, #110-#116) --------------------------------
EMAIL_PROVIDER=console
SMS_PROVIDER=console
AI_PROVIDER=mock
# Preview data only: seed with `pnpm db:seed-demo` equivalents; no customer data in staging.
BILLING_PROVIDER=mock

# --- Clock check: /readyz fails when the clock drifts more than 1 s from this reference ------------
CLOCK_DRIFT_REFERENCE_URL=https://www.cloudflare.com

# --- Admin console (staff only; never publicly routed, see #98) -----------------------------------
ADMIN_IP_ALLOWLIST=

# --- Staging overrides: smaller limits (staging shares or follows the prod sizing) -----------------------
CADDY_MEM=64m
CADDY_CPUS=0.15
WEB_MEM=384m
WEB_CPUS=0.5
API_MEM=384m
API_CPUS=0.5
WORKER_MEM=256m
WORKER_CPUS=0.35
ADMIN_MEM=256m
ADMIN_CPUS=0.25
POSTGRES_MEM=1g
POSTGRES_CPUS=1.0
MINIO_MEM=256m
MINIO_CPUS=0.25

# --- Backups and DR (#101): same variables as prod.env.example; the weekly restore drill
# (.github/workflows/restore-drill.yml) restores THIS environment's backups. -------------------
WALG_KEY_FILE=/run/causedeck/walg.key
BACKUP_RETAIN_DAILY=14
BACKUP_RETAIN_WEEKLY=8
REPLICA_ENDPOINT=
REPLICA_REGION=ap-south-2
REPLICA_BUCKET=
REPLICA_ACCESS_KEY=
REPLICA_SECRET_KEY=
ALLOW_LOCAL_ENDPOINTS=1
