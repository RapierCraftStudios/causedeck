# WAL-G settings reference (#101). Variables only, no secrets. compose.prod.yml passes these to the
# postgres container (archive_command in postgresql.conf), the `backup` service and the restore
# scripts; set them in the stack env file (env/prod.env.example) or the shell that runs a restore.

# Where backups go. Stage A archives to the stack's MinIO bucket; infra/scripts/backup/minio-replicate.sh
# copies it off-host to a second India location. Real AWS S3 (Stage B) leaves AWS_ENDPOINT unset and
# needs an India region. Anything else is rejected by infra/scripts/backup/lib/india-guard.sh.
WALG_S3_PREFIX=s3://causedeck-wal
AWS_ENDPOINT=http://minio:9000
AWS_REGION=ap-south-1
AWS_S3_FORCE_PATH_STYLE=true

# Credentials (one set per duty, least privilege):
#   archiver  (postgres container)  put objects only          WALG_ARCHIVE_ACCESS_KEY / _SECRET_KEY
#   maintain  (backup service)      list, put, delete (retention) WALG_ADMIN_ACCESS_KEY / _SECRET_KEY
#   restore   (drill, restore-prod) list and get only          AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY at restore time
# Buckets are never public; MinIO access logging is on in the audit stack (#102).

# Client-side encryption: WAL-G libsodium. The 32-byte key (hex or raw) is a FILE, never a value in
# an env file or image layer. Without it wal-push, backup-fetch and wal-fetch all fail.
WALG_LIBSODIUM_KEY_PATH=/run/secrets/walg_key
WALG_LIBSODIUM_KEY_TRANSFORM=hex

WALG_COMPRESSION_METHOD=zstd

# Retention (read by walg-basebackup.sh): 14 daily base backups with WAL for 14 days of PITR, plus
# 8 weekly backups kept as permanent until they age out.
BACKUP_RETAIN_DAILY=14
BACKUP_RETAIN_WEEKLY=8
# WAL is kept for as long as the oldest retained daily backup needs it: 14 days of PITR.
BACKUP_WAL_DAYS=14

# Status reports for system.backup.health (ops bucket on the primary MinIO).
OPS_ENDPOINT=http://minio:9000
OPS_BUCKET=causedeck-ops
OPS_REGION=ap-south-1
