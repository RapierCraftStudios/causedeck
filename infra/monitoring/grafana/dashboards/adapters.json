{
  "uid": "cd-adapters",
  "title": "Adapters",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "timezone": "Asia/Kolkata",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "1m",
  "tags": ["causedeck"],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Parse success ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "expr": "adapter_parse_success_ratio",
          "refId": "A",
          "legendFormat": "{{adapter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Seconds since last success",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "expr": "time() - adapter_last_success_timestamp",
          "refId": "A",
          "legendFormat": "{{adapter}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
