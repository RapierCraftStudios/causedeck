{
  "name": "causedeck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "pnpm stack:up && node scripts/dev.mjs",
    "stack:up": "bash infra/scripts/dev-up.sh",
    "stack:down": "bash infra/scripts/dev-down.sh",
    "stack:reset": "bash infra/scripts/dev-reset.sh",
    "doctor": "node --experimental-strip-types --no-warnings infra/scripts/doctor.ts",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:tenancy": "turbo run test:tenancy",
    "test:golden": "turbo run test:golden",
    "test:export-coverage": "pnpm --filter @causedeck/core exec vitest run src/lifecycle/__tests__/export-coverage.test.ts",
    "db:generate": "turbo run db:generate --filter=@causedeck/db",
    "db:migrate": "turbo run db:migrate --filter=@causedeck/db",
    "db:check": "turbo run db:check --filter=@causedeck/db",
    "db:studio": "turbo run db:studio --filter=@causedeck/db",
    "db:seed": "turbo run db:seed --filter=@causedeck/db",
    "db:seed:demo": "turbo run db:seed:demo --filter=@causedeck/db",
    "db:check-rls": "turbo run db:check-rls --filter=@causedeck/db",
    "i18n:check": "pnpm --filter @causedeck/i18n i18n:check",
    "i18n:types": "pnpm --filter @causedeck/i18n i18n:types",
    "test:ci-scripts": "node --experimental-strip-types --no-warnings --test 'infra/scripts/*.test.mjs' 'infra/scripts/*.test.ts'",
    "check:no-l5": "node --experimental-strip-types --no-warnings scripts/check-no-l5.ts",
    "adr:lint": "node docs/adr/scripts/lint-adr.mjs",
    "adr:new": "node docs/adr/scripts/new-adr.mjs",
    "adr:test": "node --test \"docs/adr/scripts/*.test.mjs\"",
    "docs:links": "node docs/adr/scripts/check-links.mjs",
    "docs:permissions": "pnpm --filter @causedeck/auth docs:permissions",
    "docs:permissions:check": "pnpm --filter @causedeck/auth docs:permissions:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "env:example": "pnpm --filter @causedeck/config env:example",
    "env:example:check": "pnpm --filter @causedeck/config env:example:check",
    "audit:prod": "pnpm audit --prod --audit-level high",
    "prepare": "lefthook install"
  },
  "prettier": "@causedeck/config/prettier",
  "devDependencies": {
    "@causedeck/config": "workspace:*",
    "@commitlint/cli": "catalog:",
    "@commitlint/config-conventional": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "catalog:",
    "lefthook": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-tailwindcss": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
