    "docs:permissions:check": "tsx scripts/gen-permissions-doc.ts --check"
  },
  "dependencies": {
    "@better-auth/passkey": "catalog:",
    "@causedeck/config": "workspace:*",
    "@causedeck/db": "workspace:*",
