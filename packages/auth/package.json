{
  "name": "@causedeck/auth",
  "version": "0.0.0",
  "private": true,
  "description": "Better Auth config, roles and permissions, session helpers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./client": "./src/client.ts",
    "./session": "./src/session.ts",
    "./mailer": "./src/mailer.ts",
    "./messages": "./src/messages.ts",
    "./rate-limit": "./src/rate-limit.ts",
    "./step-up": "./src/step-up.ts",
    "./dev-provider": "./src/dev-provider.ts",
    "./policy": "./src/policy/index.ts",
    "./policy/visibility": "./src/policy/visibility.ts",
    "./react": "./src/react/use-can.ts"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
