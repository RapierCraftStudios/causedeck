  "devDependencies": {
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/web-push": "catalog:",
    "eslint": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
