{
  "name": "@causedeck/notifications",
  "version": "0.0.0",
  "private": true,
  "description": "Email, web push, in-app notifications, digests.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./categories": "./src/categories.ts",
    "./service": "./src/service.ts",
