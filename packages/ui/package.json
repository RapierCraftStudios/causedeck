{
  "name": "@causedeck/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Design system: tokens, shadcn components, patterns, Storybook.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./button": "./src/components/button/index.ts",
    "./spinner": "./src/components/spinner/index.ts",
    "./kbd": "./src/components/kbd/index.ts",
    "./hooks": "./src/hooks/index.ts",
    "./motion": "./src/lib/motion.ts",
    "./tokens.css": "./tokens/index.css",
    "./tokens/*": "./tokens/*",
    "./fonts.css": "./fonts/fonts.css",
    "./fonts/*": "./fonts/*"
  },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook --project storybook-dark --project browser",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:stories": "tsx scripts/check-stories.ts",
    "check:bundle": "tsx scripts/check-bundle-size.ts",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "gen:tokens": "tsx scripts/gen-token-docs.ts"
  },
  "dependencies": {
    "class-variance-authority": "catalog:",
    "clsx": "catalog:",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "radix-ui": "catalog:",
    "tailwind-merge": "catalog:",
    "tailwindcss": "catalog:",
    "tw-animate-css": "catalog:"
  },
  "devDependencies": {
    "@causedeck/config": "workspace:*",
    "@storybook/addon-a11y": "catalog:",
    "@storybook/addon-docs": "catalog:",
    "@storybook/addon-vitest": "catalog:",
    "@storybook/nextjs-vite": "catalog:",
    "@tailwindcss/cli": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/culori": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitest/browser": "catalog:",
    "apca-w3": "catalog:",
    "culori": "catalog:",
    "esbuild": "catalog:",
    "eslint": "catalog:",
    "jsdom": "catalog:",
    "next": "catalog:",
    "playwright": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "storybook": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "react": "catalog:",
    "react-dom": "catalog:"
  }
}
