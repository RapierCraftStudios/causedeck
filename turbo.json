{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["NODE_ENV", "CI", "GITHUB_ACTIONS", "SKIP_ENV_VALIDATION"],
  "globalPassThroughEnv": ["TURBO_TOKEN", "TURBO_TEAM"],
  "globalDependencies": ["tsconfig.base.json", ".eslintrc*", "eslint.config.js"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/**",
        "$TURBO_ROOT$/packages/**",
        "$TURBO_ROOT$/docs/adr/**",
        "$TURBO_ROOT$/docs/engineering/**",
        "$TURBO_ROOT$/infra/docker/**",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next/**",
        "!$TURBO_ROOT$/**/.next-e2e/**",
        "!$TURBO_ROOT$/**/.turbo/**",
        "!$TURBO_ROOT$/**/.cache/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/reports/**",
        "!$TURBO_ROOT$/**/storybook-static/**",
        "!$TURBO_ROOT$/**/test-results/**",
        "!$TURBO_ROOT$/**/playwright-report/**",
        "!$TURBO_ROOT$/**/*.tsbuildinfo"
      ],
      "outputs": ["coverage/**", "reports/**"]
    },
    "test:tenancy": {
      "cache": false
    },
    "test:golden": {
      "cache": false,
      "passThroughEnv": ["ADAPTER_PRIVATE_FIXTURES_DIR"]
    },
    "db:generate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL_OWNER"]
    },
    "db:migrate": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL_OWNER"]
    },
    "db:check": {
      "inputs": ["src/**", "scripts/**", "migrations/**", "drizzle.config.ts"],
      "passThroughEnv": ["DATABASE_URL_OWNER"]
    },
    "db:studio": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["DATABASE_URL_OWNER"]
    },
    "db:seed": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL"]
    },
    "db:seed:demo": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_OWNER", "NODE_ENV"]
    },
    "db:check-rls": {
      "cache": false,
      "passThroughEnv": ["DATABASE_URL", "DATABASE_URL_OWNER"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
